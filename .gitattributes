# Store text with LF line endings so scripts behave the same on every platform
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
# the built plugin is generated by `npm run build`: keep it out of diffs and language stats
plugin/bin/** linguist-generated
plugin/ui/** linguist-generated
